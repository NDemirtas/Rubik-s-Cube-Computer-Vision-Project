def find_all_stickers(roi, offset_x, offset_y):
    """Detects clean individual facelet contours & centroids across the ROI."""
    gray = cv2.cvtColor(roi, cv2.COLOR_BGR2GRAY)
    blur = cv2.GaussianBlur(gray, (5, 5), 0)
    thresh = cv2.adaptiveThreshold(blur, 255, cv2.ADAPTIVE_THRESH_GAUSSIAN_C, 
                                   cv2.THRESH_BINARY_INV, 11, 2)

    contours, _ = cv2.findContours(thresh, cv2.RETR_TREE, cv2.CHAIN_APPROX_SIMPLE)

    stickers = []
    roi_area = roi.shape[0] * roi.shape[1]

    for cnt in contours:
        area = cv2.contourArea(cnt)
        if (roi_area * 0.003) < area < (roi_area * 0.25):
            peri = cv2.arcLength(cnt, True)
            approx = cv2.approxPolyDP(cnt, 0.04 * peri, True)

            if 4 <= len(approx) <= 8:
                rect = cv2.minAreaRect(cnt)
                (cx_float, cy_float), (w, h), angle = rect
                if w > 0 and h > 0:
                    aspect_ratio = max(w, h) / min(w, h)
                    if aspect_ratio < 2.2:
                        cx = int(cx_float) + offset_x
                        cy = int(cy_float) + offset_y
                        cnt_full = cnt + np.array([[[offset_x, offset_y]]])

                        stickers.append({
                            'center': np.array([cx, cy], dtype=np.float32),
                            'angle': angle,
                            'contour': cnt_full
                        })
    return stickers


def estimate_k_faces(stickers):
    """Determines whether 1, 2, or 3 faces are visible based on sticker count & spread."""
    n = len(stickers)
    if n < 4:
        return 0
    elif n <= 11:
        return 1
    elif n <= 19:
        return 2
    else:
        return 3


def cluster_stickers_into_k_faces(stickers, k):
    """
    Uses OpenCV K-Means to separate adjacent faces cleanly based on 
    spatial position (X, Y) and sticker orientation.
    """
    if k == 0 or len(stickers) < k:
        return []

    # Build feature vector: [X, Y, 0.3 * Angle]
    features = []
    for s in stickers:
        cx, cy = s['center']
        ang = s['angle']
        features.append([cx, cy, ang * 0.3])

    features = np.array(features, dtype=np.float32)

    # OpenCV K-Means
    criteria = (cv2.TERM_CRITERIA_EPS + cv2.TERM_CRITERIA_MAX_ITER, 20, 0.2)
    _, labels, _ = cv2.kmeans(features, k, None, criteria, 10, cv2.KMEANS_PP_CENTERS)

    clusters = [[] for _ in range(k)]
    for idx, label in enumerate(labels.flatten()):
        clusters[label].append(stickers[idx])

    # Filter out empty or tiny noise clusters
    valid_clusters = [c for c in clusters if len(c) >= 3]
    valid_clusters.sort(key=lambda c: len(c), reverse=True)
    return valid_clusters


def order_quad_points(pts):
    pts = pts.reshape((4, 2))
    rect = np.zeros((4, 2), dtype="float32")
    s = pts.sum(axis=1)
    rect[0] = pts[np.argmin(s)]
    rect[2] = pts[np.argmax(s)]
    diff = np.diff(pts, axis=1)
    rect[1] = pts[np.argmin(diff)]
    rect[3] = pts[np.argmax(diff)]
    return rect


