def extract_face_quad(cluster_stickers, face_idx, alpha=0.35):
    """
    Extracts face quad with pitch expansion and finger-occlusion temporal locking.
    """
    global smoothed_faces

    pts = np.array([s['center'] for s in cluster_stickers], dtype=np.float32)
    n_dots = len(pts)

    # 1. Measure median pitch (s) between adjacent sticker centers
    dists = []
    for p in pts:
        d = np.linalg.norm(pts - p, axis=1)
        d_sorted = np.sort(d)
        if len(d_sorted) > 1:
            dists.append(d_sorted[1])
    pitch = np.median(dists) if len(dists) > 0 else 35.0

    # 2. Get minAreaRect around visible sticker contours
    all_contours = [s['contour'] for s in cluster_stickers]
    combined = np.vstack(all_contours)
    rect = cv2.minAreaRect(combined)
    (cx, cy), (w, h), angle = rect

    # 3. EXPAND: Force box dimensions to full 3x3 face span (~2.85 * pitch)
    expected_span = pitch * 2.85
    w_fixed = max(w, expected_span)
    h_fixed = max(h, expected_span)

    expanded_rect = ((cx, cy), (w_fixed, h_fixed), angle)
    box = cv2.boxPoints(expanded_rect)
    raw_corners = order_quad_points(box)

    # 4. TEMPORAL LOCK: If fingers cover dots (n_dots < 8), rely on previous full quad
    effective_alpha = alpha if n_dots >= 8 else 0.05  # Heavy lock if fingers present

    if face_idx in smoothed_faces:
        prev = smoothed_faces[face_idx]
        smoothed = (effective_alpha * raw_corners) + ((1 - effective_alpha) * prev)
    else:
        smoothed = raw_corners

    smoothed_faces[face_idx] = smoothed
    return smoothed


