import cv2
import glob
import numpy as np
from ultralytics import YOLO

# --- 1. HSV COLOR CALIBRATION ---
COLOR_RANGES_HSV = {
    'Red':    [((0, 120, 70), (10, 255, 255)), ((170, 120, 70), (180, 255, 255))],
    'Orange': [((11, 120, 70), (25, 255, 255))],
    'Yellow': [((26, 100, 100), (35, 255, 255))],
    'Green':  [((36, 100, 80), (85, 255, 255))],
    'Blue':   [((86, 100, 80), (125, 255, 255))],
    'White':  [((0, 0, 160), (180, 50, 255))]
}

DRAW_COLORS = {
    'White': (255, 255, 255), 'Yellow': (0, 255, 255), 'Red': (0, 0, 255),
    'Orange': (0, 165, 255),  'Blue': (255, 0, 0),   'Green': (0, 255, 0),
    'Unknown': (128, 128, 128)
}

def identify_color(hsv_patch):
    """Determines dominant color in an HSV patch."""
    max_pixels = 0
    best_color = 'Unknown'
    for color_name, ranges in COLOR_RANGES_HSV.items():
        total_mask = np.zeros(hsv_patch.shape[:2], dtype=np.uint8)
        for (lower, upper) in ranges:
            mask = cv2.inRange(hsv_patch, np.array(lower), np.array(upper))
            total_mask = cv2.bitwise_or(total_mask, mask)
            
        count = cv2.countNonZero(total_mask)
        if count > max_pixels:
            max_pixels = count
            best_color = color_name
    return best_color


def remove_skin(roi):
    """Masks out human skin tones within the ROI to keep fingers from breaking face edges."""
    hsv = cv2.cvtColor(roi, cv2.COLOR_BGR2HSV)
    lower_skin = np.array([0, 20, 70], dtype=np.uint8)
    upper_skin = np.array([20, 255, 255], dtype=np.uint8)
    
    skin_mask = cv2.inRange(hsv, lower_skin, upper_skin)
    non_skin_mask = cv2.bitwise_not(skin_mask)
    return cv2.bitwise_and(roi, roi, mask=non_skin_mask)


def order_quad_points(pts):
    """Orders 4 points as [Top-Left, Top-Right, Bottom-Right, Bottom-Left]."""
    pts = pts.reshape((4, 2))
    rect = np.zeros((4, 2), dtype="float32")

    s = pts.sum(axis=1)
    rect[0] = pts[np.argmin(s)]
    rect[2] = pts[np.argmax(s)]

    diff = np.diff(pts, axis=1)
    rect[1] = pts[np.argmin(diff)]
    rect[3] = pts[np.argmax(diff)]

    return rect


def process_face_quad(frame, quad_pts, face_idx, warp_size=240):
    """Warps an angled face quad into a 240x240 grid with 3x3 color sampling."""
    ordered_pts = order_quad_points(quad_pts)
    
    dst_pts = np.float32([
        [0, 0], [warp_size, 0], 
        [warp_size, warp_size], [0, warp_size]
    ])

    M = cv2.getPerspectiveTransform(ordered_pts, dst_pts)
    flat_face = cv2.warpPerspective(frame, M, (warp_size, warp_size))
    hsv_face = cv2.cvtColor(flat_face, cv2.COLOR_BGR2HSV)

    cell_size = warp_size // 3
    margin = int(cell_size * 0.30)
    grid_3x3 = []

    for r in range(3):
        row_colors = []
        for c in range(3):
            x_start, y_start = c * cell_size, r * cell_size
            patch = hsv_face[
                y_start + margin : y_start + cell_size - margin,
                x_start + margin : x_start + cell_size - margin
            ]

            color = identify_color(patch)
            row_colors.append(color)

            # Draw HUD grid overlays
            draw_bgr = DRAW_COLORS.get(color, (128, 128, 128))
            cv2.rectangle(flat_face, (x_start, y_start), 
                          (x_start + cell_size, y_start + cell_size), (0, 255, 0), 1)
            cv2.putText(flat_face, color[0], (x_start + (cell_size // 2) - 10, y_start + (cell_size // 2) + 10),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.7, draw_bgr, 2)

        grid_3x3.append(row_colors)

    cv2.putText(flat_face, f"FACE {face_idx + 1}", (10, 25), 
                cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)
    return flat_face


# --- 2. LOAD MODEL & CAMERA ---
weights_search = glob.glob("runs/detect/*/weights/best.pt") + glob.glob("runs/pose/*/weights/best.pt")
MODEL_PATH = sorted(weights_search)[-1] if weights_search else "yolov8n.pt"
print(f"Loading YOLO model: {MODEL_PATH}")

model = YOLO(MODEL_PATH)

cap = cv2.VideoCapture(0)
if not cap.isOpened():
    cap = cv2.VideoCapture(1)

is_paused = False
last_annotated_frame = None
last_combined_views = None

print("\n--- CONTROLS ---")
print("Press SPACEBAR : Pause / Resume Live Feed")
print("Press 'q'      : Quit Program\n")


# --- 3. MAIN LOOP ---
while True:
    if not is_paused:
        ret, frame = cap.read()
        if not ret:
            break

        frame = cv2.flip(frame, 1)
        h_frame, w_frame, _ = frame.shape
        annotated_frame = frame.copy()

        # Step A: YOLO Detects Cube Bounding Box
        results = model(frame, conf=0.30, verbose=False)
        boxes = results[0].boxes

        warped_faces = []

        if len(boxes) > 0:
            # Pick the largest detected bounding box (assumed to be the main cube)
            box_areas = [(b.xyxy[0][2] - b.xyxy[0][0]) * (b.xyxy[0][3] - b.xyxy[0][1]) for b in boxes]
            best_idx = np.argmax(box_areas)
            best_box = boxes[best_idx].xyxy[0].cpu().numpy().astype(int)

            # Add padding around the YOLO bounding box to avoid cutting off face edges
            pad = 20
            x1 = max(0, best_box[0] - pad)
            y1 = max(0, best_box[1] - pad)
            x2 = min(w_frame, best_box[2] + pad)
            y2 = min(h_frame, best_box[3] + pad)

            # Draw YOLO Bounding Box
            cv2.rectangle(annotated_frame, (x1, y1), (x2, y2), (255, 165, 0), 2)
            cv2.putText(annotated_frame, "YOLO Cube Target ROI", (x1, max(20, y1 - 10)),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 165, 0), 2)

            # Step B: Extract ROI & Apply Skin-Masked Edge Detection
            roi = frame[y1:y2, x1:x2]
            if roi.shape[0] > 50 and roi.shape[1] > 50:
                roi_no_skin = remove_skin(roi)
                gray = cv2.cvtColor(roi_no_skin, cv2.COLOR_BGR2GRAY)
                blurred = cv2.GaussianBlur(gray, (5, 5), 0)
                edged = cv2.Canny(blurred, 30, 120)

                # Connect broken edge lines caused by fingertips
                kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (5, 5))
                closed = cv2.morphologyEx(edged, cv2.MORPH_CLOSE, kernel, iterations=2)

                # Step C: Find 1 to 3 Face Quads inside ROI
                contours, _ = cv2.findContours(closed, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
                valid_quads = []

                for cnt in contours:
                    area = cv2.contourArea(cnt)
                    # Lower threshold suited for ROI size
                    if area > 800:
                        hull = cv2.convexHull(cnt)
                        peri = cv2.arcLength(hull, True)
                        approx = cv2.approxPolyDP(hull, 0.04 * peri, True)

                        if len(approx) == 4:
                            valid_quads.append((area, approx))

                # Take up to 3 largest face polygons
                valid_quads.sort(key=lambda x: x[0], reverse=True)
                top_quads = [q[1] for q in valid_quads[:3]]

                # Step D: Offset Quad Points back to Full Frame & Perspective Warp
                for i, quad_in_roi in enumerate(top_quads):
                    # Offset ROI local coordinates back to full camera coordinates
                    quad_full = quad_in_roi + np.array([[[x1, y1]]])

                    # Draw polygon on webcam view
                    cv2.polylines(annotated_frame, [quad_full], True, (0, 255, 0), 2)

                    # Warp face grid
                    flat_face_img = process_face_quad(frame, quad_full, i)
                    warped_faces.append(flat_face_img)

        last_combined_views = np.hstack(warped_faces) if len(warped_faces) > 0 else None
        last_annotated_frame = annotated_frame

    # Step E: Freeze Frame Controls
    display_frame = last_annotated_frame.copy() if last_annotated_frame is not None else frame
    if is_paused:
        cv2.putText(display_frame, "PAUSED (Press SPACEBAR to resume)", (20, 50),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.9, (0, 0, 255), 3)

    cv2.imshow("YOLO + OpenCV Hybrid Cube Detector", display_frame)
    if last_combined_views is not None:
        cv2.imshow("Extracted 3x3 Face Views (1-3)", last_combined_views)

    key = cv2.waitKey(1) & 0xFF
    if key == ord(' '):
        is_paused = not is_paused
    elif key == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()