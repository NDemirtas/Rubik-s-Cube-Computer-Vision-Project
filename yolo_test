import cv2
from ultralytics import YOLO

# 1. Load a pre-trained YOLOv8 model (Nano version is fast on M1 Mac)
# Ultralytics will auto-download yolo11n.pt on first run
model = YOLO("yolo11n.pt") 

cap = cv2.VideoCapture(1)

while True:
    ret, frame = cap.read()
    if not ret:
        break

    frame = cv2.flip(frame, 1)

    # 2. Run inference on device 'mps' (Apple Silicon GPU)
    results = model(frame, device="mps", verbose=False)

    # 3. Render detections directly onto frame
    annotated_frame = results[0].plot()

    cv2.imshow("YOLOv8 Real-Time Tracking", annotated_frame)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()