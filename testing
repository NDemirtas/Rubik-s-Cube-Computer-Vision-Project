import cv2
import glob
import os

IMAGE_DIR = "YOLO-pose dataset images"
LABEL_DIR = "yolo_pose_labels"
os.makedirs(LABEL_DIR, exist_ok=True)

image_files = sorted(glob.glob(os.path.join(IMAGE_DIR, "*.jpg"))) + sorted(
    glob.glob(os.path.join(IMAGE_DIR, "*.png"))
)

POINT_NAMES = [
    "0: Center Y-Junction",
    "1: Top Outer Corner",
    "2: Top-Right Corner",
    "3: Bottom-Right Corner",
    "4: Bottom Outer Corner",
    "5: Bottom-Left Corner",
    "6: Top-Left Corner",
]

current_kpts = []  # Stores (x, y, vis)
display_img = None


def click_event(event, x, y, flags, param):
    global current_kpts, display_img
    # LEFT CLICK = Visible point (vis = 2)
    if event == cv2.EVENT_LBUTTONDOWN and len(current_kpts) < 7:
        current_kpts.append((x, y, 2))

    # RIGHT CLICK = Hidden/Not visible point (vis = 0)
    elif event == cv2.EVENT_RBUTTONDOWN and len(current_kpts) < 7:
        current_kpts.append((0, 0, 0))


cv2.namedWindow("Local Annotator")
cv2.setMouseCallback("Local Annotator", click_event)

for img_idx, img_path in enumerate(image_files):
    base_name = os.path.basename(img_path)
    txt_name = os.path.splitext(base_name)[0] + ".txt"
    txt_path = os.path.join(LABEL_DIR, txt_name)

    if os.path.exists(txt_path):
        continue

    current_img = cv2.imread(img_path)
    if current_img is None:
        continue
    h, w, _ = current_img.shape
    current_kpts = []

    while True:
        display_img = current_img.copy()

        # Re-draw captured keypoints
        for idx, (pt_x, pt_y, vis) in enumerate(current_kpts):
            if vis == 2:
                cv2.circle(display_img, (pt_x, pt_y), 5, (0, 255, 0), -1)
                cv2.putText(
                    display_img,
                    f"K{idx}",
                    (pt_x + 7, pt_y - 5),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.5,
                    (0, 255, 255),
                    2,
                )
            else:
                # Indicate hidden/skipped point
                cv2.putText(
                    display_img,
                    f"K{idx}: HIDDEN",
                    (15, 60 + (idx * 20)),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.4,
                    (0, 0, 255),
                    1,
                )

        next_pt = len(current_kpts)
        instruction = (
            f"Click {POINT_NAMES[next_pt]} (L-Click: Show | R-Click: Hide)"
            if next_pt < 7
            else "ENTER: Save | R: Reset"
        )

        cv2.putText(
            display_img,
            f"[{img_idx+1}/{len(image_files)}] {instruction}",
            (15, 30),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.5,
            (255, 255, 255),
            2,
        )

        cv2.imshow("Local Annotator", display_img)
        key = cv2.waitKey(20) & 0xFF

        # Press 's' to skip/hide current point using keyboard
        if key == ord("s") and len(current_kpts) < 7:
            current_kpts.append((0, 0, 0))

        # ENTER to save and advance
        elif key == 13 and len(current_kpts) == 7:
            # Extract only visible points to calculate bounding box
            vis_pts = [(x, y) for (x, y, v) in current_kpts if v > 0]

            if len(vis_pts) > 0:
                xs = [pt[0] / w for pt in vis_pts]
                ys = [pt[1] / h for pt in vis_pts]
                x_min, x_max = min(xs), max(xs)
                y_min, y_max = min(ys), max(ys)
                bbox_x, bbox_y = (x_min + x_max) / 2, (y_min + y_max) / 2
                bbox_w, bbox_h = x_max - x_min, y_max - y_min
            else:
                bbox_x, bbox_y, bbox_w, bbox_h = 0.5, 0.5, 0.5, 0.5

            label_line = [
                f"0 {bbox_x:.6f} {bbox_y:.6f} {bbox_w:.6f} {bbox_h:.6f}"
            ]
            for pt_x, pt_y, vis in current_kpts:
                if vis > 0:
                    label_line.append(f"{pt_x / w:.6f} {pt_y / h:.6f} {vis}")
                else:
                    label_line.append("0.000000 0.000000 0")

            with open(txt_path, "w") as f:
                f.write(" ".join(label_line) + "\n")

            print(f"Saved: {txt_name}")
            break

        elif key == ord("r"):
            current_kpts = []
        elif key == ord("q"):
            cv2.destroyAllWindows()
            exit()

cv2.destroyAllWindows()
print("Annotation Complete!")