import cv2
import numpy as np

# --- 1. HSV COLOR CALIBRATION ---
COLOR_RANGES_HSV = {
    'Red':    [((0, 120, 70), (10, 255, 255)), ((170, 120, 70), (180, 255, 255))],
    'Orange': [((11, 120, 70), (25, 255, 255))],
    'Yellow': [((26, 100, 100), (35, 255, 255))],
    'Green':  [((36, 100, 80), (85, 255, 255))],
    'Blue':   [((86, 100, 80), (125, 255, 255))],
    'White':  [((0, 0, 160), (180, 50, 255))]
}

DRAW_COLORS = {
    'White': (255, 255, 255), 'Yellow': (0, 255, 255), 'Red': (0, 0, 255),
    'Orange': (0, 165, 255),  'Blue': (255, 0, 0),   'Green': (0, 255, 0),
    'Unknown': (128, 128, 128)
}

def identify_color(hsv_patch):
    """Identifies color while ignoring black plastic background or skin pixels."""
    max_pixels = 0
    best_color = 'Unknown'
    for color_name, ranges in COLOR_RANGES_HSV.items():
        total_mask = np.zeros(hsv_patch.shape[:2], dtype=np.uint8)
        for (lower, upper) in ranges:
            mask = cv2.inRange(hsv_patch, np.array(lower), np.array(upper))
            total_mask = cv2.bitwise_or(total_mask, mask)
            
        count = cv2.countNonZero(total_mask)
        if count > max_pixels:
            max_pixels = count
            best_color = color_name
    return best_color


def remove_skin_and_enhance_cube(frame):
    """Filters out skin tones to prevent fingers from corrupting contours."""
    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
    
    # Range for typical human skin tones in HSV
    lower_skin = np.array([0, 20, 70], dtype=np.uint8)
    upper_skin = np.array([20, 255, 255], dtype=np.uint8)
    
    skin_mask = cv2.inRange(hsv, lower_skin, upper_skin)
    
    # Invert skin mask so skin becomes black
    non_skin_mask = cv2.bitwise_not(skin_mask)
    
    # Black out skin areas on the frame
    cleaned_frame = cv2.bitwise_and(frame, frame, mask=non_skin_mask)
    return cleaned_frame


def order_quad_points(pts):
    """Orders 4 points as [Top-Left, Top-Right, Bottom-Right, Bottom-Left]."""
    pts = pts.reshape((4, 2))
    rect = np.zeros((4, 2), dtype="float32")

    s = pts.sum(axis=1)
    rect[0] = pts[np.argmin(s)]
    rect[2] = pts[np.argmax(s)]

    diff = np.diff(pts, axis=1)
    rect[1] = pts[np.argmin(diff)]
    rect[3] = pts[np.argmax(diff)]

    return rect


def process_face_quad(frame, quad_pts, face_idx, warp_size=240):
    ordered_pts = order_quad_points(quad_pts)
    
    dst_pts = np.float32([
        [0, 0], [warp_size, 0], 
        [warp_size, warp_size], [0, warp_size]
    ])

    M = cv2.getPerspectiveTransform(ordered_pts, dst_pts)
    flat_face = cv2.warpPerspective(frame, M, (warp_size, warp_size))
    hsv_face = cv2.cvtColor(flat_face, cv2.COLOR_BGR2HSV)

    cell_size = warp_size // 3
    margin = int(cell_size * 0.30)
    grid_3x3 = []

    for r in range(3):
        row_colors = []
        for c in range(3):
            x_start, y_start = c * cell_size, r * cell_size
            patch = hsv_face[
                y_start + margin : y_start + cell_size - margin,
                x_start + margin : x_start + cell_size - margin
            ]

            color = identify_color(patch)
            row_colors.append(color)

            draw_bgr = DRAW_COLORS.get(color, (128, 128, 128))
            cv2.rectangle(flat_face, (x_start, y_start), 
                          (x_start + cell_size, y_start + cell_size), (0, 255, 0), 1)
            cv2.putText(flat_face, color[0], (x_start + (cell_size // 2) - 10, y_start + (cell_size // 2) + 10),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.7, draw_bgr, 2)

        grid_3x3.append(row_colors)

    cv2.putText(flat_face, f"FACE {face_idx + 1}", (10, 25), 
                cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)
    return flat_face


# --- MAIN CAMERA LOOP ---
cap = cv2.VideoCapture(0)
if not cap.isOpened():
    cap = cv2.VideoCapture(1)

is_paused = False
last_annotated_frame = None
last_combined_views = None

while True:
    if not is_paused:
        ret, frame = cap.read()
        if not ret:
            break

        frame = cv2.flip(frame, 1)
        annotated_frame = frame.copy()

        # Step 1: Black out skin pixels to stop finger contour bleeding
        no_skin_frame = remove_skin_and_enhance_cube(frame)

        gray = cv2.cvtColor(no_skin_frame, cv2.COLOR_BGR2GRAY)
        blurred = cv2.GaussianBlur(gray, (5, 5), 0)
        edged = cv2.Canny(blurred, 30, 120)

        # Morphological Closing bridges small gaps caused by finger tips
        kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (5, 5))
        closed = cv2.morphologyEx(edged, cv2.MORPH_CLOSE, kernel, iterations=3)

        contours, _ = cv2.findContours(closed, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

        valid_quads = []
        for cnt in contours:
            area = cv2.contourArea(cnt)
            if 3000 < area < 90000:
                # Use Convex Hull to ignore finger indentations on face edges
                hull = cv2.convexHull(cnt)
                peri = cv2.arcLength(hull, True)
                approx = cv2.approxPolyDP(hull, 0.04 * peri, True)

                if len(approx) == 4:
                    valid_quads.append((area, approx))

        valid_quads.sort(key=lambda x: x[0], reverse=True)
        top_quads = [q[1] for q in valid_quads[:3]]

        warped_faces = []
        for i, quad in enumerate(top_quads):
            cv2.polylines(annotated_frame, [quad], True, (0, 255, 0), 3)
            flat_face_img = process_face_quad(frame, quad, i)
            warped_faces.append(flat_face_img)

        last_combined_views = np.hstack(warped_faces) if len(warped_faces) > 0 else None
        last_annotated_frame = annotated_frame

    display_frame = last_annotated_frame.copy() if last_annotated_frame is not None else frame
    if is_paused:
        cv2.putText(display_frame, "PAUSED (Press SPACEBAR to resume)", (20, 50),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.9, (0, 0, 255), 3)

    cv2.imshow("Skin-Filtered Cube Detector", display_frame)
    if last_combined_views is not None:
        cv2.imshow("Warped Faces (1-3)", last_combined_views)

    key = cv2.waitKey(1) & 0xFF
    if key == ord(' '):
        is_paused = not is_paused
    elif key == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()