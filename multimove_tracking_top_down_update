        "Blue (D)": (start_x + 4 * box_s, start_y + 6 * box_s, 18),
    }

    for name, (fx, fy, base_idx) in face_offsets.items():
        for r in range(3):
            for c in range(3):
                idx = base_idx + r * 3 + c
                color_str = cube_tracker.state[idx]
