cube_tracker = PermutationCubeTracker()
sequence_tracker = SequenceBufferedTracker(cube_tracker)


def run_flask():
    socketio.run(app, host="0.0.0.0", port=5000, debug=False, use_reloader=False)


flask_thread = threading.Thread(target=run_flask, daemon=True)
flask_thread.start()


# --- MAIN CV LOOP ---
while True:
    ret, frame = cap.read()
    if not ret:
        break

    results = model(frame, stream=True, verbose=False)

    for r in results:
        if r.masks is not None:
            for mask in r.masks.xy:
                if len(mask) >= 4:
                    rect = cv2.minAreaRect(mask.astype(np.float32))
                    box = cv2.boxPoints(rect)
                    box = np.int32(box)

                    cv2.polylines(frame, [box], True, (0, 255, 0), 2)

                    grid, flat_face = extract_facelet_grid_with_debug(frame, box)
                    sequence_tracker.process_camera_frame(grid)
                    draw_permutation_ui(frame, grid, flat_face, cube_tracker)

    cv2.imshow("Rubik's Cube Top-Down Tracker", frame)
    key = cv2.waitKey(1) & 0xFF
    if key == ord('q'):
        break
    elif key == ord('r'):
        cube_tracker.reset_to_solved()
    elif key == ord('s'):
        cube_tracker.trigger_kociemba_solve()

cap.release()
cv2.destroyAllWindows()