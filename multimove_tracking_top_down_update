CAMERA_TO_USER_MOVE = {
    # Camera F (Yellow) -> User U (Up)
    "F": "U",   "F'": "U'",  "F2": "U2",
    # Camera B (White) -> User D (Down)
    "B": "D",   "B'": "D'",  "B2": "D2",
    # Camera U (Green) -> User B (Back)
    "U": "B",   "U'": "B'",  "U2": "B2",
    # Camera D (Blue)  -> User F (Front)
    "D": "F",   "D'": "F'",  "D2": "F2",
    # Left & Right remain identical (Red & Orange)
    "L": "L",   "L'": "L'",  "L2": "L2",
    "R": "R",   "R'": "R'",  "R2": "R2",
}

def map_camera_move_to_user(move_str):
    """Converts detected camera moves into the user's natural perspective."""
    return CAMERA_TO_USER_MOVE.get(move_str, move_str)

def remap_kociemba_for_user(raw_solution_str):
    """Converts raw Kociemba solver output to User-calibrated sequence."""
    if not raw_solution_str or raw_solution_str == "SOLVED":
        return raw_solution_str
    
    moves = raw_solution_str.split()
    user_moves = [map_camera_move_to_user(m) for m in moves]
    return " ".join(user_moves)

