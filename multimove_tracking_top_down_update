    start_x, start_y = 20, 120
    box_s = 18

    cv2.putText(
        frame,
        "PREDICTIVE ENGINE INSPECTOR (54 Facelets)",
        (start_x, start_y - 10),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.5,
        (0, 255, 255),
        2,
    )

    face_offsets = {
        "Green (U)": (start_x + 4 * box_s, start_y, 0),
        "Red (L)": (start_x, start_y + 3 * box_s, 45),
        "Yellow (F)": (start_x + 4 * box_s, start_y + 3 * box_s, 9),
        "Orange (R)": (start_x + 8 * box_s, start_y + 3 * box_s, 36),
