import cv2
import torch
import torch.nn as nn
import torch.nn.functional as F
from torchvision import transforms
from PIL import Image
import numpy as np

# --- 1. Map Classes (ImageFolder sorts subfolders alphabetically) ---
CLASSES = ["background", "blue", "green", "orange", "red", "white", "yellow"]

# Define distinct visualization colors (BGR format for OpenCV)
COLOR_MAP = {
    "background": (128, 128, 128),
    "blue":       (255, 0, 0),
    "green":      (0, 255, 0),
    "orange":     (0, 165, 255),
    "red":        (0, 0, 255),
    "white":      (255, 255, 255),
    "yellow":     (0, 255, 255)
}

# Select compute device
if torch.backends.mps.is_available():
    device = torch.device("mps")
elif torch.cuda.is_available():
    device = torch.device("cuda")
else:
    device = torch.device("cpu")

print(f"Running inference on device: {device}")


# --- 2. Jay Hack's 6-Layer CNN Architecture ---
class HackRubiksNet(nn.Module):
    def __init__(self, num_classes=7):
        super(HackRubiksNet, self).__init__()
        self.conv1 = nn.Conv2d(in_channels=3, out_channels=32, kernel_size=3, padding=1)
        self.pool1 = nn.MaxPool2d(kernel_size=2, stride=2)
        
        self.conv2 = nn.Conv2d(in_channels=32, out_channels=64, kernel_size=3, padding=1)
        self.pool2 = nn.MaxPool2d(kernel_size=2, stride=2)
        
        self.conv3 = nn.Conv2d(in_channels=64, out_channels=128, kernel_size=3, padding=1)
        self.pool3 = nn.MaxPool2d(kernel_size=2, stride=2)
        
        self.flatten = nn.Flatten()
        self.fc1 = nn.Linear(128 * 4 * 4, 256)
        self.dropout = nn.Dropout(p=0.5)
        self.fc2 = nn.Linear(256, 128)
        self.fc3 = nn.Linear(128, num_classes)

    def forward(self, x):
        x = self.pool1(F.relu(self.conv1(x)))
        x = self.pool2(F.relu(self.conv2(x)))
        x = self.pool3(F.relu(self.conv3(x)))
        x = self.flatten(x)
        x = F.relu(self.fc1(x))
        x = self.dropout(x)
        x = F.relu(self.fc2(x))
        x = self.fc3(x)
        return x


# --- 3. Load Trained Model Weights ---
model = HackRubiksNet(num_classes=7).to(device)
try:
    model.load_state_dict(torch.load("rubiks_model.pth", map_location=device))
    model.eval()  # Set to evaluation mode (disables Dropout)
    print("Successfully loaded rubiks_model.pth")
except Exception as e:
    print(f"Error loading model weights: {e}")
    exit()

# Image Preprocessing Transform for PyTorch
transform = transforms.Compose([
    transforms.Resize((32, 32)),
    transforms.ToTensor(),
    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])
])


# --- 4. Main OpenCV Loop ---
cap = cv2.VideoCapture(0)  # Use 0 or 1 for Continuity Camera

if not cap.isOpened():
    print("Could not open camera stream.")
    exit()

print("Starting live Rubik's Cube detection. Press 'q' to quit.")

while True:
    ret, frame = cap.read()
    if not ret:
        break

    frame = cv2.flip(frame, 1)
    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
    blurred = cv2.GaussianBlur(gray, (5, 5), 0)

    # Adaptive thresholding to extract candidate square edges
    thresh = cv2.adaptiveThreshold(
        blurred, 255, cv2.ADAPTIVE_THRESH_GAUSSIAN_C,
        cv2.THRESH_BINARY_INV, 15, 3
    )

    contours, _ = cv2.findContours(thresh, cv2.RETR_TREE, cv2.CHAIN_APPROX_SIMPLE)

    detected_stickers = []

    for cnt in contours:
        area = cv2.contourArea(cnt)
        if 200 < area < 30000:  # Expanded area range
            peri = cv2.arcLength(cnt, True)
            # Use 0.02 or 0.03 instead of 0.04 to tolerate rounded/obscured corners
            approx = cv2.approxPolyDP(cnt, 0.025 * peri, True)

            # Allow 4 to 6 vertices (in case a finger or glare cuts off a corner)
            if 4 <= len(approx) <= 6:
                x, y, w, h = cv2.boundingRect(cnt)
                aspect_ratio = float(w) / h

                # Relax aspect ratio filter (0.6 to 1.4)
                if 0.6 <= aspect_ratio <= 1.4:
                    # Crop ROI from original color frame
                    roi = frame[y:y+h, x:x+w]
                    if roi.shape[0] == 0 or roi.shape[1] == 0:
                        continue

                    # Convert BGR (OpenCV) to RGB (PIL) for PyTorch
                    roi_rgb = cv2.cvtColor(roi, cv2.COLOR_BGR2RGB)
                    pil_img = Image.fromarray(roi_rgb)
                    input_tensor = transform(pil_img).unsqueeze(0).to(device)

                    # Pass through CNN
                    with torch.no_grad():
                        output = model(input_tensor)
                        probs = F.softmax(output, dim=1)
                        conf, pred_idx = torch.max(probs, 1)

                    predicted_label = CLASSES[pred_idx.item()]
                    confidence = conf.item()

                    # Filter out background noise or low-confidence predictions
                    if predicted_label != "background" and confidence > 0.60:
                        detected_stickers.append((x, y, w, h, predicted_label))

    # Draw bounding boxes and labels for verified facelets
    for x, y, w, h, label in detected_stickers:
        box_color = COLOR_MAP.get(label, (255, 255, 255))
        cv2.rectangle(frame, (x, y), (x + w, y + h), box_color, 2)
        
        # Label text background box
        cv2.putText(frame, label.upper(), (x, y - 5),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.5, box_color, 2)

    cv2.putText(frame, f"Verified Stickers: {len(detected_stickers)}", (20, 40),
                cv2.FONT_HERSHEY_SIMPLEX, 0.8, (0, 255, 0), 2)

    cv2.imshow("Rubik's Cube CNN Detector - Live", frame)

    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()