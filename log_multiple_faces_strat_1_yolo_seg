while True:
    ret, frame = cap.read()
    if not ret: break

    frame = cv2.flip(frame, 1)
    h_frame, w_frame, _ = frame.shape
    display_frame = frame.copy()

    key = cv2.waitKey(1) & 0xFF

    if key == ord('r'):
        CURRENT_CENTER = None
        CUBE_STATE = {
            col: [
                ['Unknown', 'Unknown', 'Unknown'],
                ['Unknown', col,       'Unknown'],
                ['Unknown', 'Unknown', 'Unknown']
            ] for col in VALID_COLORS
        }
        CUBE_VOTES = {
            col: [[[] for _ in range(3)] for _ in range(3)] for col in VALID_COLORS
        }
        render_logged_face_window()

    elif key == ord('q'):
        break

# RUN YOLO SEGMENTATION AUTOMATICALLY
    results = model(frame, device="mps", conf=0.40, verbose=False)[0]

    if results.masks is not None and len(results.masks) > 0:
        masks = results.masks.data.cpu().numpy()
        boxes = results.boxes.xyxy.cpu().numpy().astype(int)
        
        best_idx = np.argmax([(b[2]-b[0])*(b[3]-b[1]) for b in boxes])
        best_mask = masks[best_idx]

        mask_resized = cv2.resize(best_mask, (w_frame, h_frame))
        mask_binary = (mask_resized > 0.5).astype(np.uint8) * 255

        # Split single mask into face quads
        face_quads = split_mask_into_face_quads(mask_binary)

        current_time = time.time()
        if (current_time - last_auto_process_time) > AUTO_PROCESS_INTERVAL:
            last_auto_process_time = current_time

            for idx, quad in enumerate(face_quads):
                # Sample colors for each detected face quad independently
                warped_face = sample_colors_inside_quad(frame, quad)
                
                # Draw green boundaries for each detected face
                cv2.polylines(display_frame, [quad.astype(np.int32)], True, (0, 255, 0), 2)
                cv2.putText(display_frame, f"Face {idx+1}", (int(quad[0][0]), int(quad[0][1]) - 5),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 255), 2)
                
                cv2.imshow(f"Warped Face {idx+1}", cv2.resize(warped_face, (180, 180)))

    cv2.imshow("Main Feed", display_frame)

cap.release()
