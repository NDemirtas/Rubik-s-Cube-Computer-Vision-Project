def count_all_colors():
    """Counts current total instances of each color logged across all 6 faces."""
    counts = {col: 0 for col in VALID_COLORS}
    for center, grid in CUBE_STATE.items():
        for r in range(3):
            for c in range(3):
                col = grid[r][c]
                if col in counts:
                    counts[col] += 1
    return counts


def run_predictive_deduction():
    """Applies count constraints and infers missing facelets by process of elimination."""
    counts = count_all_colors()
    
    # 1. DEDUCT LAST MISSING COLOR(S) GLOBALLY
    total_logged = sum(counts.values())
    missing_colors = [col for col, qty in counts.items() if qty < 9]

    # If only 1 color is under-represented and total logged is high, fill remaining Unknowns
    if len(missing_colors) == 1:
        needed_color = missing_colors[0]
        for center, grid in CUBE_STATE.items():
            for r in range(3):
                for c in range(3):
                    if grid[r][c] in ['Unknown', 'Obstructed'] and counts[needed_color] < 9:
                        grid[r][c] = needed_color
                        counts[needed_color] += 1

    # 2. LOCAL FACE DEDUCTION (If a single face has 1 missing slot & 1 valid candidate left)
    for center, grid in CUBE_STATE.items():
        unknown_coords = []
        for r in range(3):
            for c in range(3):
                if grid[r][c] in ['Unknown', 'Obstructed']:
                    unknown_coords.append((r, c))

        if len(unknown_coords) == 1:
            r, c = unknown_coords[0]
            # Find candidate colors that still need facelets globally
            available = [col for col, qty in counts.items() if qty < 9]
            if len(available) == 1:
                grid[r][c] = available[0]
                counts[available[0]] += 1

def order_quad_points(pts):
    pts = pts.reshape((4, 2))
    rect = np.zeros((4, 2), dtype="float32")
    s = pts.sum(axis=1)
    rect[0] = pts[np.argmin(s)]
    rect[2] = pts[np.argmax(s)]
    diff = np.diff(pts, axis=1)
    rect[1] = pts[np.argmin(diff)]
    rect[3] = pts[np.argmax(diff)]
    return rect


