import os
import shutil
import glob
from pathlib import Path
from ultralytics import YOLO

# 1. Define local temp environment variables
LOCAL_TMP = os.path.abspath("./tmp")
os.makedirs(LOCAL_TMP, exist_ok=True)
os.environ["TMPDIR"] = LOCAL_TMP
os.environ["TEMP"] = LOCAL_TMP
os.environ["TMP"] = LOCAL_TMP

# 2. Add as many downloaded Roboflow dataset folders as you want here
DATASETS_TO_MERGE = [
    "Rubik's-Cube-Raghav-Dataset",
    "Rubik-s-Cube-Yolorobo-Dataset",  # Replace with the path to your second dataset
    "Rubik's-Cube-Yebsworkspace-Dataset"
    # "Another-Rubiks-Dataset-Path"
]

MERGED_DIR = os.path.abspath("./Merged_Rubiks_Dataset")

def merge_datasets(sources, destination):
    """Merges multiple YOLO-formatted dataset folders into one unified dataset."""
    print(f"Creating merged dataset at: {destination}")
    
    # Create structure
    for split in ["train", "valid"]:
        os.makedirs(os.path.join(destination, split, "images"), exist_ok=True)
        os.makedirs(os.path.join(destination, split, "labels"), exist_ok=True)

    img_count = 0

    for ds_idx, src in enumerate(sources):
        src_path = Path(src)
        if not src_path.exists():
            print(f"Warning: Dataset folder '{src}' not found, skipping.")
            continue

        print(f"Merging dataset: {src}")

        for split in ["train", "valid"]:
            # Handle Roboflow variations ('valid' vs 'val')
            src_split = "valid" if (src_path / "valid").exists() else ("val" if (src_path / "val").exists() else "train")
            
            img_dir = src_path / src_split / "images"
            lbl_dir = src_path / src_split / "labels"

            if not img_dir.exists():
                continue

            for img_file in img_dir.glob("*.*"):
                if img_file.suffix.lower() not in [".jpg", ".jpeg", ".png", ".bmp"]:
                    continue

                # Create unique filename prefix (e.g., ds0_image12.jpg)
                new_name = f"ds{ds_idx}_{img_file.name}"
                lbl_file = lbl_dir / f"{img_file.stem}.txt"

                # Copy image
                dst_img = os.path.join(destination, split, "images", new_name)
                shutil.copy(img_file, dst_img)

                # Copy label if present
                if lbl_file.exists():
                    dst_lbl = os.path.join(destination, split, "labels", f"ds{ds_idx}_{img_file.stem}.txt")
                    shutil.copy(lbl_file, dst_lbl)

                img_count += 1

    # 3. Create unified data.yaml
    yaml_content = f"""path: {destination}
train: train/images
val: valid/images

names:
  0: Rubiks-Cube
"""
    yaml_path = os.path.join(destination, "data.yaml")
    with open(yaml_path, "w") as f:
        f.write(yaml_content)

    print(f"Merge Complete! Total images merged: {img_count}")
    return yaml_path

# Execute Merge
merged_yaml = merge_datasets(DATASETS_TO_MERGE, MERGED_DIR)

# 4. Clear old cache files
for c in glob.glob(f"{MERGED_DIR}/**/*.cache", recursive=True):
    try:
        os.remove(c)
    except OSError:
        pass

# 5. Train YOLOv8-Seg on the combined dataset
model = YOLO("yolov8n-seg.pt")

results = model.train(
    data=merged_yaml,
    epochs=50,            # Higher epoch count for larger dataset
    imgsz=640,
    batch=8,
    device="mps",
    single_cls=True,      # Forces all labels across datasets into class 0
    project="runs/segment",
    name="rubiks_seg_combined",
    exist_ok=True
)

print("\nCombined Segmentation Training Complete!")
print("Best weights saved to: runs/segment/rubiks_seg_combined/weights/best.pt")