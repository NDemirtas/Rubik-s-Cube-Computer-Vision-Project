import cv2
import glob
import numpy as np
from ultralytics import YOLO

# --- 1. HSV COLOR CALIBRATION ---
COLOR_RANGES_HSV = {
    'Red':    [((0, 120, 70), (10, 255, 255)), ((170, 120, 70), (180, 255, 255))],
    'Orange': [((11, 120, 70), (25, 255, 255))],
    'Yellow': [((26, 100, 100), (35, 255, 255))],
    'Green':  [((36, 100, 80), (85, 255, 255))],
    'Blue':   [((86, 100, 80), (125, 255, 255))],
    'White':  [((0, 0, 150), (180, 45, 255))]
}

DRAW_COLORS = {
    'White': (255, 255, 255), 'Yellow': (0, 255, 255), 'Red': (0, 0, 255),
    'Orange': (0, 165, 255),  'Blue': (255, 0, 0),   'Green': (0, 255, 0),
    'Unknown': (128, 128, 128)
}

smoothed_faces = {}

def detect_stickers_in_roi(roi, offset_x, offset_y):
    hsv = cv2.cvtColor(roi, cv2.COLOR_BGR2HSV)
    h, s, v = cv2.split(hsv)
    clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))
    v = clahe.apply(v)
    hsv = cv2.merge([h, s, v])

    stickers = []
    for color_name, ranges in COLOR_RANGES_HSV.items():
        color_mask = np.zeros(hsv.shape[:2], dtype=np.uint8)
        for (lower, upper) in ranges:
            mask = cv2.inRange(hsv, np.array(lower), np.array(upper))
            color_mask = cv2.bitwise_or(color_mask, mask)

        kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (5, 5))
        color_mask = cv2.morphologyEx(color_mask, cv2.MORPH_ERODE, kernel, iterations=1)
        color_mask = cv2.morphologyEx(color_mask, cv2.MORPH_DILATE, kernel, iterations=1)

        contours, _ = cv2.findContours(color_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

        for cnt in contours:
            area = cv2.contourArea(cnt)
            if 150 < area < 12000:
                peri = cv2.arcLength(cnt, True)
                approx = cv2.approxPolyDP(cnt, 0.04 * peri, True)

                if 4 <= len(approx) <= 8:
                    rect = cv2.minAreaRect(cnt)
                    w, h = rect[1]
                    if w > 0 and h > 0:
                        aspect_ratio = max(w, h) / min(w, h)
                        if aspect_ratio < 2.2:
                            (cx_float, cy_float), _ = cv2.minEnclosingCircle(cnt)
                            cx = int(cx_float) + offset_x
                            cy = int(cy_float) + offset_y
                            
                            stickers.append({
                                'center': np.array([cx, cy], dtype=np.float32),
                                'color': color_name
                            })
    return stickers


def extract_primary_and_secondary_faces(stickers, max_faces=3):
    """Clusters dots into 1-3 faces."""
    if len(stickers) < 4:
        return []

    remaining_stickers = list(stickers)
    face_clusters = []

    for f_idx in range(max_faces):
        if len(remaining_stickers) < 5:  # Require at least 5 dots to predict grid
            break

        centers = np.array([s['center'] for s in remaining_stickers])
        best_cluster = []

        for i, pt_a in enumerate(centers):
            dists = np.linalg.norm(centers - pt_a, axis=1)
            neighbors = [remaining_stickers[j] for j, d in enumerate(dists) if d < 85]
            if len(neighbors) > len(best_cluster):
                best_cluster = neighbors

        if len(best_cluster) >= 5:
            cluster_centers = np.array([s['center'] for s in best_cluster])
            mean_pt = np.mean(cluster_centers, axis=0)
            best_cluster.sort(key=lambda s: np.linalg.norm(s['center'] - mean_pt))
            selected_face_stickers = best_cluster[:9]

            face_clusters.append(selected_face_stickers)

            used_centers = [s['center'] for s in selected_face_stickers]
            remaining_stickers = [
                s for s in remaining_stickers 
                if not any(np.array_equal(s['center'], uc) for uc in used_centers)
            ]
        else:
            break

    return face_clusters


def extrapolate_missing_dots(face_stickers):
    """
    AI Grid Extrapolator: Takes 5 to 9 messy dots and forces them into 
    a perfect 9-point grid by analyzing rotation and spacing.
    """
    pts = np.array([s['center'] for s in face_stickers])
    if len(pts) < 5:
        return pts

    mean_pt = np.mean(pts, axis=0)
    centered_pts = pts - mean_pt

    best_theta = 0
    max_score = -1

    # 1. Sweep 90 degrees to find the perfect grid orientation
    for angle in range(0, 90):
        theta = np.radians(angle)
        c, s = np.cos(theta), np.sin(theta)
        R = np.array(((c, -s), (s, c)))
        rot_pts = centered_pts.dot(R.T)
        
        xs = np.sort(rot_pts[:, 0])
        ys = np.sort(rot_pts[:, 1])
        
        # When perfectly aligned, the gaps between the 3 columns are maximized
        dx = np.diff(xs)
        dy = np.diff(ys)
        score = np.sum(np.sort(dx)[-2:]) + np.sum(np.sort(dy)[-2:])
        
        if score > max_score:
            max_score = score
            best_theta = theta

    # 2. Rotate points to the optimal flat alignment
    c, s = np.cos(best_theta), np.sin(best_theta)
    R = np.array(((c, -s), (s, c)))
    rot_pts = centered_pts.dot(R.T)

    # 3. Measure outer bounds to generate 3 equal rows and columns
    xmin, xmax = np.min(rot_pts[:, 0]), np.max(rot_pts[:, 0])
    ymin, ymax = np.min(rot_pts[:, 1]), np.max(rot_pts[:, 1])
    
    cx = [xmin, xmin + (xmax - xmin)/2.0, xmax]
    cy = [ymin, ymin + (ymax - ymin)/2.0, ymax]

    ideal_grid_rot = np.array([[x, y] for x in cx for y in cy])
    
    # 4. Rotate the perfect 9 dots back to camera space
    R_inv = np.array(((c, s), (-s, c)))
    ideal_grid = ideal_grid_rot.dot(R_inv.T) + mean_pt
    
    return ideal_grid


def order_quad_points(pts):
    pts = pts.reshape((4, 2))
    rect = np.zeros((4, 2), dtype="float32")
    s = pts.sum(axis=1)
    rect[0] = pts[np.argmin(s)]
    rect[2] = pts[np.argmax(s)]
    diff = np.diff(pts, axis=1)
    rect[1] = pts[np.argmin(diff)]
    rect[3] = pts[np.argmax(diff)]
    return rect


def synthesize_and_smooth_corners(ideal_grid_pts, face_idx, alpha=0.35):
    """Builds the bounding box directly from the AI-generated grid, not contours."""
    global smoothed_faces

    # Since we have the perfect 9 point grid, the minAreaRect perfectly traces the true face edges
    rect = cv2.minAreaRect(ideal_grid_pts.astype(np.float32))
    box = cv2.boxPoints(rect)
    raw_corners = order_quad_points(box)

    if face_idx in smoothed_faces:
        prev_corners = smoothed_faces[face_idx]
        smoothed_corners = (alpha * raw_corners) + ((1 - alpha) * prev_corners)
    else:
        smoothed_corners = raw_corners

    smoothed_faces[face_idx] = smoothed_corners
    return smoothed_corners


def process_face_quad(frame, quad_pts, face_idx, warp_size=240):
    dst_pts = np.float32([[0, 0], [warp_size, 0], [warp_size, warp_size], [0, warp_size]])
    M = cv2.getPerspectiveTransform(quad_pts.astype(np.float32), dst_pts)
    flat_face = cv2.warpPerspective(frame, M, (warp_size, warp_size))
    hsv_face = cv2.cvtColor(flat_face, cv2.COLOR_BGR2HSV)

    cell_size = warp_size // 3
    margin = int(cell_size * 0.30)

    for r in range(3):
        for c in range(3):
            x_start, y_start = c * cell_size, r * cell_size
            patch = hsv_face[y_start + margin : y_start + cell_size - margin, x_start + margin : x_start + cell_size - margin]

            max_px = 0
            best_col = 'Unknown'
            for col_name, ranges in COLOR_RANGES_HSV.items():
                mask = np.zeros(patch.shape[:2], dtype=np.uint8)
                for (l, u) in ranges:
                    mask = cv2.bitwise_or(mask, cv2.inRange(patch, np.array(l), np.array(u)))
                cnt = cv2.countNonZero(mask)
                if cnt > max_px:
                    max_px = cnt
                    best_col = col_name

            draw_bgr = DRAW_COLORS.get(best_col, (128, 128, 128))
            cv2.rectangle(flat_face, (x_start, y_start), (x_start + cell_size, y_start + cell_size), (0, 255, 0), 1)
            cv2.putText(flat_face, best_col[0], (x_start + (cell_size // 2) - 10, y_start + (cell_size // 2) + 10),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.7, draw_bgr, 2)

    cv2.putText(flat_face, f"FACE {face_idx + 1}", (10, 25), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 255), 2)
    return flat_face


# --- MAIN CAMERA LOOP ---
weights = glob.glob("runs/detect/*/weights/best.pt") + glob.glob("runs/pose/*/weights/best.pt")
model = YOLO(weights[-1] if weights else "yolov8n.pt")

cap = cv2.VideoCapture(0)
if not cap.isOpened():
    cap = cv2.VideoCapture(1)

is_paused = False
last_annotated_frame = None
last_combined_views = None

print("\n--- AI GRID EXTRAPOLATOR ---")
print("Press SPACEBAR : Pause / Resume Live Feed")
print("Press 'q'      : Quit Program\n")

while True:
    if not is_paused:
        ret, frame = cap.read()
        if not ret:
            break

        frame = cv2.flip(frame, 1)
        h_frame, w_frame, _ = frame.shape
        annotated_frame = frame.copy()

        results = model(frame, conf=0.30, verbose=False)
        boxes = results[0].boxes

        warped_faces = []

        if len(boxes) > 0:
            box_areas = [(b.xyxy[0][2] - b.xyxy[0][0]) * (b.xyxy[0][3] - b.xyxy[0][1]) for b in boxes]
            best_box = boxes[np.argmax(box_areas)].xyxy[0].cpu().numpy().astype(int)

            pad = 15
            x1 = max(0, best_box[0] - pad)
            y1 = max(0, best_box[1] - pad)
            x2 = min(w_frame, best_box[2] + pad)
            y2 = min(h_frame, best_box[3] + pad)

            cv2.rectangle(annotated_frame, (x1, y1), (x2, y2), (255, 165, 0), 2)

            roi = frame[y1:y2, x1:x2]
            stickers = detect_stickers_in_roi(roi, offset_x=x1, offset_y=y1)

            # Draw raw detected cyan dots
            for s in stickers:
                cx, cy = int(s['center'][0]), int(s['center'][1])
                cv2.circle(annotated_frame, (cx, cy), 3, (255, 255, 0), -1)

            face_clusters = extract_primary_and_secondary_faces(stickers, max_faces=3)
            current_face_ids = set()

            for i, face_stickers in enumerate(face_clusters):
                current_face_ids.add(i)

                # 🚀 Apply Intelligent Grid Extrapolation
                ideal_grid = extrapolate_missing_dots(face_stickers)

                # Draw the AI predicted perfect 9-dot grid in HOT PINK
                for pt in ideal_grid:
                    cv2.circle(annotated_frame, (int(pt[0]), int(pt[1])), 5, (200, 105, 255), -1)

                # Form corners from the perfect grid, ignoring raw missing points
                smoothed_corners = synthesize_and_smooth_corners(ideal_grid, face_idx=i)
                cv2.polylines(annotated_frame, [smoothed_corners.astype(np.int32)], True, (0, 255, 0), 2)

                flat_face_img = process_face_quad(frame, smoothed_corners, i)
                warped_faces.append(flat_face_img)

            stale_keys = [k for k in smoothed_faces.keys() if k not in current_face_ids]
            for k in stale_keys:
                del smoothed_faces[k]
        else:
            smoothed_faces.clear()

        last_combined_views = np.hstack(warped_faces) if len(warped_faces) > 0 else None
        last_annotated_frame = annotated_frame

    display_frame = last_annotated_frame.copy() if last_annotated_frame is not None else frame
    if is_paused:
        cv2.putText(display_frame, "PAUSED (Press SPACEBAR)", (20, 50), cv2.FONT_HERSHEY_SIMPLEX, 0.9, (0, 0, 255), 3)

    cv2.imshow("AI Grid Extrapolator", display_frame)
    if last_combined_views is not None:
        cv2.imshow("Warped Face Views (1-3)", last_combined_views)

    key = cv2.waitKey(1) & 0xFF
    if key == ord(' '):
        is_paused = not is_paused
    elif key == ord('q'):
        break

cap.release()
cv2.destroyAllWindows()