# Thread-safe buffer for captured facelet snapshots
snapshot_queue = queue.Queue()

class SequenceBufferedTracker:

    def __init__(self, cube_tracker):
        self.tracker = cube_tracker
        self.sequence_queue = queue.Queue()

        self.recorded_snapshots = []
        self.last_clean_grid = None
        self.stable_frames = 0

        # Timing thresholds (at ~30 FPS)
        self.MIN_HOLD = 3  # 2 frames (~60ms) of stability = snapshot recorded
        self.SETTLE_PAUSE = (
            10  # 10 frames (~330ms) of stability = move sequence finished!
        )

        # Worker thread for background BFS / Kociemba resolution
        self.consumer_thread = threading.Thread(
            target=self._sequence_consumer, daemon=True
        )
        self.consumer_thread.start()
        print("🚀 [SequenceTracker] Background Consumer Thread Running...")

    def _normalize(self, grid_data):
        """Standardizes facelet arrays into flat string lists."""
        if grid_data is None:
            return []
        if isinstance(grid_data, list) and len(grid_data) > 0:
            if isinstance(grid_data[0], list):
                grid_data = [c for row in grid_data for c in row]
        return [str(x) for x in list(grid_data)]

    # --- PRODUCER (Runs continuously inside main OpenCV loop) ---
    def process_camera_frame(self, scanned_grid):
        if scanned_grid is None:
            return

        flat_grid = self._normalize(scanned_grid)

        # Motion filtering to discard active turning blur
        if flat_grid == self.last_clean_grid:
            self.stable_frames += 1
        else:
            self.last_clean_grid = flat_grid
            self.stable_frames = 0
            return

        # 1. Capture clean snapshots during micro-pauses between moves
        if self.stable_frames == self.MIN_HOLD:
            last_recorded = (
                self.recorded_snapshots[-1]
                if self.recorded_snapshots
                else self._normalize(self.tracker.state[18:27])
            )

            if flat_grid != last_recorded:
                self.recorded_snapshots.append(flat_grid)
                print(
                    f"📷 [Captured Step #{len(self.recorded_snapshots)}] Pattern recorded"
                )

        # 2. SETTLE DETECTED: You stopped moving! Offload the recorded chain
        if (
            self.stable_frames == self.SETTLE_PAUSE
            and len(self.recorded_snapshots) > 0
        ):
            print(
                f"📥 [Producer] Settle pause detected! Passing {len(self.recorded_snapshots)} snapshot(s) to worker..."
            )
            self.sequence_queue.put(list(self.recorded_snapshots))

            # Reset local buffer for your next turn sequence
            self.recorded_snapshots.clear()

    # --- CONSUMER (Runs asynchronously in background) ---
    # --- CONSUMER (Runs asynchronously in background) ---
    def _sequence_consumer(self):
        while True:
            try:
                snapshots_chain = self.sequence_queue.get(timeout=1)
            except queue.Empty:
                continue

            try:
                target_front = snapshots_chain[-1]

                # Run BFS to bridge current tracker state -> target settled state
                resolved_moves = self._resolve_bfs_sequence(
                    target_front, max_depth=5
                )

                if resolved_moves:
                    # Apply all moves in sequence to update state array
                    for m in resolved_moves:
                        perm = self.tracker.permutations[m]
                        self.tracker.state = self.tracker.state[perm]

                    # Detect move transition using Kociemba state comparison
                    detected_transition = (
                        self.tracker.detect_move_between_states()
                    )

                    # Broadcast multi-move update to Three.js and HUD
                    self.tracker.broadcast_state()

                    print(
                        f"\n⚡ [Consumer] RESOLVED SEQUENCE: {', '.join(resolved_moves)}"
                    )
                    print(
                        f"🧩 [Consumer] KOCIEMBA DETECTED MOVE: {detected_transition}\n"
                    )
                else:
                    print(
                        "⚠️ [Consumer] Couldn't resolve move sequence within depth limit."
                    )

            except Exception as e:
                print(f"❌ [Consumer Exception]: {e}")
                traceback.print_exc()

            finally:
                self.sequence_queue.task_done()

    def _resolve_bfs_sequence(self, target_front, max_depth=5):
        """Shortest-path BFS solver from current state to target front pattern."""
        initial_front = self._normalize(self.tracker.state[18:27])
        if target_front == initial_front:
            return []

        queue_bfs = deque([(self.tracker.state.copy(), [])])
        visited_fronts = {tuple(initial_front)}

        while queue_bfs:
            curr_state, path = queue_bfs.popleft()

            if len(path) >= max_depth:
                continue

            for move_name, perm in self.tracker.permutations.items():
                next_state = curr_state[perm]
                next_front = self._normalize(next_state[18:27])
                next_front_tuple = tuple(next_front)

                if next_front == target_front:
                    return path + [move_name]

                if next_front_tuple not in visited_fronts:
                    visited_fronts.add(next_front_tuple)
                    queue_bfs.append((next_state, path + [move_name]))



