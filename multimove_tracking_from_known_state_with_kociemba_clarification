while True:
    ret, frame = cap.read()
    if not ret:
        break

    # 1. Flip once immediately for UI display
    display_frame = cv2.flip(frame, 1)
    h_frame, w_frame, _ = display_frame.shape

    # 2. Run YOLO directly on display_frame (Green box tracks correctly on screen)
    results = model(display_frame, conf=0.40, verbose=False)[0]
    quad_corners = None
    current_grid, flat_face = None, None

    if results.masks is not None and len(results.masks) > 0:
        masks = results.masks.data.cpu().numpy()
        boxes = results.boxes.xyxy.cpu().numpy().astype(int)
        best_idx = np.argmax([(b[2] - b[0]) * (b[3] - b[1]) for b in boxes])

        mask_resized = cv2.resize(masks[best_idx], (w_frame, h_frame))
        mask_binary = (mask_resized > 0.5).astype(np.uint8) * 255

        contours, _ = cv2.findContours(
            mask_binary, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
        )
        if contours:
            cnt = max(contours, key=cv2.contourArea)
            peri = cv2.arcLength(cnt, True)
            approx = cv2.approxPolyDP(cnt, 0.03 * peri, True)
            pts = (
                approx.reshape(4, 2)
                if len(approx) == 4
                else cv2.boxPoints(cv2.minAreaRect(cnt))
            )

            s = pts.sum(axis=1)
            diff = np.diff(pts, axis=1)
            rect = np.zeros((4, 2), dtype="float32")
            rect[0] = pts[np.argmin(s)]
            rect[2] = pts[np.argmax(s)]
            rect[1] = pts[np.argmin(diff)]
            rect[3] = pts[np.argmax(diff)]
            quad_corners = rect

            # Draw green box directly on display_frame
            cv2.polylines(
                display_frame,
                [quad_corners.astype(np.int32)],
                True,
                (0, 255, 0),
                2,
            )

    if quad_corners is not None:
        # 3. Un-flip quad_corners x-coordinates ONLY for processing the unflipped raw frame
        raw_corners = quad_corners.copy()
        raw_corners[:, 0] = w_frame - raw_corners[:, 0]

        # Re-sort corners for raw_corners to maintain top-left to bottom-right ordering
        s_raw = raw_corners.sum(axis=1)
        diff_raw = np.diff(raw_corners, axis=1)
        rect_raw = np.zeros((4, 2), dtype="float32")
        rect_raw[0] = raw_corners[np.argmin(s_raw)]
        rect_raw[2] = raw_corners[np.argmax(s_raw)]
        rect_raw[1] = raw_corners[np.argmin(diff_raw)]
        rect_raw[3] = raw_corners[np.argmax(diff_raw)]

        current_grid, flat_face = extract_facelet_grid_with_debug(
            frame, rect_raw
        )

        # 4. NON-BLOCKING ASYNC PRODUCER:
        # Continually records frames in real-time, only triggers resolution on settle
        async_pipeline.process_camera_frame(current_grid)

    # Draw UI State Overlay
    draw_permutation_ui(display_frame, current_grid, flat_face)

    # On-Screen Info Header
    cv2.putText(
        display_frame,
        f"Front Face Center: {cube_tracker.state[22]}",
        (20, 35),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.65,
        (0, 255, 0),
        2,
    )
    cv2.putText(
        display_frame,
        f"Last Move: {cube_tracker.last_move_detected}",
        (20, 70),
        cv2.FONT_HERSHEY_SIMPLEX,
        0.65,
        (255, 255, 255),
        2,
    )

    cv2.imshow("Rubik's Permutation Debugger (Async Mode)", display_frame)

    key = cv2.waitKey(1) & 0xFF
    if key == ord("q"):
        break
    elif key == ord("r"):
        cube_tracker.reset_to_solved()
    elif key == ord("s"):
        solution = cube_tracker.solve_with_kociemba()
        if solution:
            cube_tracker.last_move_detected = f"Solve: {solution}"
            cube_tracker.broadcast_state()

cap.release()
