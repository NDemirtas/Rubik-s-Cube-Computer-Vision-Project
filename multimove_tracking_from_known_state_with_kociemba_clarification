    def solve_with_kociemba(self):
        """Solves standard state and flips R/L and F/F' on the final move output."""
        k_str = self.state_to_kociemba_string()
        if not k_str:
            return None

        try:
            raw_solution = kociemba.solve(k_str)
            raw_moves = raw_solution.split()

            # Output translation dictionary:
            # - Swaps R and L entirely (R -> L, L -> R, R' -> L', L' -> R', etc.)
            # - Inverts F direction (F -> F', F' -> F)
            move_remap = {
                # Swapping R and L
                "R": "L",   "R'": "L'",  "R2": "L2",
                "L": "R",   "L'": "R'",  "L2": "R2",
                # Inverting Front direction
                "F": "F'",  "F'": "F",   "F2": "F2",
            }

            # Remap moves while leaving U, D, and B moves completely untouched
            corrected_moves = [move_remap.get(m, m) for m in raw_moves]
            solution = " ".join(corrected_moves)

            print(f"🧩 [KOCIEMBA RAW]:       {raw_solution}")
            print(f"⚡ [KOCIEMBA CORRECTED]: {solution}")
            return solution

        except Exception as e:
            print(f"❌ [Kociemba Solver Error]: {e}")
            return None
        
    def detect_move_between_states(self):
        """Calculates move(s) made from self.previous_state -> self.state using Kociemba target pattern matching."""
        if np.array_equal(self.previous_state, self.state):
            return "No Move"

        prev_kstr = self.state_to_kociemba_string(self.previous_state)
        curr_kstr = self.state_to_kociemba_string(self.state)

        if not prev_kstr or not curr_kstr:
            print("⚠️ [Kociemba]: Unrecognized or incomplete color mapping in state array.")
            return "Invalid State"

        try:
            # Pass (Start State, Target State) to Kociemba
            raw_solution = kociemba.solve(prev_kstr, curr_kstr)
            raw_moves = raw_solution.split()

            # Move rotation remapping (R<->L, F<->F')
            move_remap = {
                "R": "L",
                "R'": "L'",
                "R2": "L2",
                "L": "R",
                "L'": "R'",
                "L2": "R2",
                "F": "F'",
                "F'": "F",
                "F2": "F2",
            }
            corrected_moves = [move_remap.get(m, m) for m in raw_moves]
            move_detected = " ".join(corrected_moves)

            # Advance previous state baseline forward
            self.previous_state = self.state.copy()
            self.last_move_detected = move_detected

            return move_detected

        except Exception as e:
            print(f"❌ [Kociemba Transition Error]: {e}")
            return "Unknown Transition"

    def solve_with_kociemba(self):
        """Solves cube from current state to standard solved state."""
        k_str = self.state_to_kociemba_string(self.state)
        if not k_str:
            return None

        try:
            raw_solution = kociemba.solve(k_str)
            raw_moves = raw_solution.split()

            move_remap = {
                "R": "L",
                "R'": "L'",
                "R2": "L2",
                "L": "R",
                "L'": "R'",
                "L2": "R2",
                "F": "F'",
                "F'": "F",
                "F2": "F2",
            }

            corrected_moves = [move_remap.get(m, m) for m in raw_moves]
            solution = " ".join(corrected_moves)

            print(f"⚡ [KOCIEMBA SOLUTION]: {solution}")
            return solution

        except Exception as e:
            print(f"❌ [Kociemba Solver Error]: {e}")
            return None

def get_color_from_patch(hsv_patch):
    total_pixels = hsv_patch.shape[0] * hsv_patch.shape[1]
    if total_pixels == 0:
        return "Unknown"

    best_color = "Unknown"
    max_match_pct = 0.0

    for col_name, ranges in COLOR_RANGES_HSV.items():
        mask = np.zeros(hsv_patch.shape[:2], dtype=np.uint8)
        for lower, upper in ranges:
            mask = cv2.bitwise_or(
                mask, cv2.inRange(hsv_patch, np.array(lower), np.array(upper))
            )

        match_pct = cv2.countNonZero(mask) / total_pixels
        if match_pct > max_match_pct and match_pct > 0.15:
            max_match_pct = match_pct
            best_color = col_name

    return best_color


def extract_facelet_grid_with_debug(frame, quad_pts, warp_size=240):
    dst_pts = np.float32(
        [[0, 0], [warp_size, 0], [warp_size, warp_size], [0, warp_size]]
    )
    M = cv2.getPerspectiveTransform(quad_pts.astype(np.float32), dst_pts)
    flat_face = cv2.warpPerspective(frame, M, (warp_size, warp_size))
    hsv_face = cv2.cvtColor(flat_face, cv2.COLOR_BGR2HSV)

    cell_size = warp_size // 3
    margin = int(cell_size * 0.35)

    grid = [["Unknown"] * 3 for _ in range(3)]

    for r in range(3):
        for c in range(3):
            x_start, y_start = c * cell_size, r * cell_size
            hsv_patch = hsv_face[
                y_start + margin : y_start + cell_size - margin,
                x_start + margin : x_start + cell_size - margin,
            ]
            grid[r][c] = get_color_from_patch(hsv_patch)

    return grid, flat_face


