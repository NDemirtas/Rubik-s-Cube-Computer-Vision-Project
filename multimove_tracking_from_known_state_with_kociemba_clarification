class PermutationCubeTracker:
    """
    1D Permutation Matrix Tracker - R, R', L, L', U, U', D, D' moves.
    Indices:
      0-8: White (U), 9-17: Yellow (D), 18-26: Green (F)
      27-35: Blue (B), 36-44: Orange (L), 45-53: Red (R)
    """

    F_INDICES = [18, 19, 20, 21, 22, 23, 24, 25, 26]

    def __init__(self):
        # Initialize default solved state
        self.state = np.array([...])  # your 54-element array
        self.previous_state = self.state.copy()  # Track the previous state
        self.state = np.empty(54, dtype="<U10")
        self.permutations = {}
        self._init_permutation_matrix()

        self.last_move_detected = "None"
        self.move_history = []
        self.max_allowed_error = 2
        self.last_grid = None
        self.grid_stable_count = 0
        self.last_candidate_dists = {}
        self.reset_to_solved()

    def reset_to_solved(self):
        self.state = np.array(
            ["White"] * 9
            + ["Yellow"] * 9
            + ["Green"] * 9
            + ["Blue"] * 9
            + ["Orange"] * 9
            + ["Red"] * 9,
            dtype="<U10",
        )
        self.last_move_detected = "None"
        self.move_history = []
        self.last_grid = None
        self.grid_stable_count = 0
        self.last_candidate_dists = {}
        print("\n[PERMUTATION ENGINE] State reset to SOLVED.\n")
        self.broadcast_state()

    def _init_permutation_matrix(self):
        I = np.arange(54)

        def rot_cw(idx_list):
            return [
                idx_list[6], idx_list[3], idx_list[0],
                idx_list[7], idx_list[4], idx_list[1],
                idx_list[8], idx_list[5], idx_list[2],
            ]

        # --- Helper for Face Rotations ---
        def rot_ccw(idx_list):
            return [
                idx_list[2], idx_list[5], idx_list[8],
                idx_list[1], idx_list[4], idx_list[7],
                idx_list[0], idx_list[3], idx_list[6]
            ]

        def rot_180(idx_list):
            return idx_list[::-1]

        # --- R MOVE (Swapped Assignment: Drives Orange [36:45] and LEFT columns) ---
        pR = I.copy()
        pR[36:45] = rot_cw(I[36:45])

        pR[[18, 21, 24]] = I[[0, 3, 6]]      # White Col 0 -> Green Col 0
        pR[[9, 12, 15]]  = I[[18, 21, 24]]   # Green Col 0 -> Yellow Col 0
        pR[[35, 32, 29]] = I[[9, 12, 15]]    # Yellow Col 0 -> Blue Col 2
        pR[[0, 3, 6]]    = I[[35, 32, 29]]   # Blue Col 2  -> White Col 0

        self.permutations["R"]  = pR
        self.permutations["R'"] = np.argsort(pR)

        # --- L MOVE (Swapped Assignment: Drives Red [45:54] and RIGHT columns) ---
        pL = I.copy()
        pL[45:54] = rot_cw(I[45:54])

        pL[[2, 5, 8]]    = I[[20, 23, 26]]   # Green Col 2 -> White Col 2
        pL[[33, 30, 27]] = I[[2, 5, 8]]      # White Col 2 -> Blue Col 0
        pL[[11, 14, 17]] = I[[33, 30, 27]]   # Blue Col 0  -> Yellow Col 2
        pL[[20, 23, 26]] = I[[11, 14, 17]]   # Yellow Col 2 -> Green Col 2

        self.permutations["L"]  = pL
        self.permutations["L'"] = np.argsort(pL)

        # --- U MOVE (Up Face Clockwise) ---
        pU = I.copy()
        pU[0:9] = rot_cw(I[0:9])

        pU[[36, 37, 38]] = I[[18, 19, 20]]   # Green Row 0 -> Orange Row 0
        pU[[27, 28, 29]] = I[[36, 37, 38]]   # Orange Row 0 -> Blue Row 0
        pU[[45, 46, 47]] = I[[27, 28, 29]]   # Blue Row 0 -> Red Row 0
        pU[[18, 19, 20]] = I[[45, 46, 47]]   # Red Row 0 -> Green Row 0

        self.permutations["U"] = pU
        self.permutations["U'"] = np.argsort(pU)

        # --- D MOVE (Down Face Clockwise) ---
        pD = I.copy()
        pD[9:18] = rot_cw(I[9:18])  # Rotate Yellow face clockwise

        # Cycle bottom rows: Green -> Red -> Blue -> Orange -> Green
        pD[[51, 52, 53]] = I[[24, 25, 26]]   # Green Row 2 -> Red Row 2
        pD[[33, 34, 35]] = I[[51, 52, 53]]   # Red Row 2 -> Blue Row 2
        pD[[42, 43, 44]] = I[[33, 34, 35]]   # Blue Row 2 -> Orange Row 2
        pD[[24, 25, 26]] = I[[42, 43, 44]]   # Orange Row 2 -> Green Row 2

        self.permutations["D"] = pD
        self.permutations["D'"] = np.argsort(pD)

        # --- F MOVE (Front Face: Green [18:27] Clockwise) ---
        # Cycles adjacent inner edges: 
        # White Bottom Row [6, 7, 8] -> Red Left Col [45, 48, 51] -> Yellow Top Row [11, 10, 9] -> Orange Right Col [44, 41, 38] -> White Bottom Row
        pF = I.copy()
        pF[18:27] = rot_cw(I[18:27])  # Rotates GREEN face Clockwise

        pF[[45, 48, 51]] = I[[6, 7, 8]]      # White Row 2 -> Red Col 0
        pF[[11, 10, 9]]  = I[[45, 48, 51]]  # Red Col 0   -> Yellow Row 0 (Inverted)
        pF[[44, 41, 38]] = I[[11, 10, 9]]   # Yellow Row 0 -> Orange Col 2 (Inverted)
        pF[[6, 7, 8]]    = I[[44, 41, 38]]  # Orange Col 2 -> White Row 2

        self.permutations["F'"]  = pF
        self.permutations["F"] = np.argsort(pF)

        # --- B MOVE (Back Face: Blue [27:36] Clockwise) ---
        # Cycles outer boundary ring:
        # White Top Row [0, 1, 2] -> Orange Left Col [36, 39, 42] -> Yellow Bottom Row [17, 16, 15] -> Red Right Col [53, 50, 47] -> White Top Row
        pB = I.copy()
        pB[27:36] = rot_cw(I[27:36])  # Rotates BLUE face Clockwise

        pB[[36, 39, 42]] = I[[2, 1, 0]]      # White Row 0 (Inv) -> Orange Col 0
        pB[[17, 16, 15]] = I[[36, 39, 42]]  # Orange Col 0 -> Yellow Row 2 (Inv)
        pB[[53, 50, 47]] = I[[17, 16, 15]]  # Yellow Row 2 (Inv) -> Red Col 2 (Inv)
        pB[[0, 1, 2]]    = I[[53, 50, 47]]  # Red Col 2 (Inv) -> White Row 0

        self.permutations["B"]  = pB
        self.permutations["B'"] = np.argsort(pB)

        # --- M MOVE (Middle Slice - Direction of L) ---
        pM = I.copy()
        pM[[19, 22, 25]] = I[[1, 4, 7]]       # White Col 1 -> Green Col 1
        pM[[10, 13, 16]] = I[[19, 22, 25]]   # Green Col 1 -> Yellow Col 1
        pM[[34, 31, 28]] = I[[10, 13, 16]]   # Yellow Col 1 -> Blue Col 1 (Inv)
        pM[[1, 4, 7]]    = I[[34, 31, 28]]   # Blue Col 1 (Inv) -> White Col 1

        self.permutations["M'"] = pM
        self.permutations["M"] = np.argsort(pM)

        # --- E MOVE (Equator Slice - Direction of D) ---
        pE = I.copy()
        pE[[48, 49, 50]] = I[[21, 22, 23]]   # Green Row 1 -> Red Row 1
        pE[[30, 31, 32]] = I[[48, 49, 50]]   # Red Row 1 -> Blue Row 1
        pE[[39, 40, 41]] = I[[30, 31, 32]]   # Blue Row 1 -> Orange Row 1
        pE[[21, 22, 23]] = I[[39, 40, 41]]   # Orange Row 1 -> Green Row 1

        self.permutations["E'"] = pE
        self.permutations["E"] = np.argsort(pE)

        # --- x ROTATION (Entire Cube Pitch - Direction of R) ---
        # Face movements: F -> U, U -> B (inverted), B -> D (inverted), D -> F
        # R face turns CW, L face turns CCW
        px = I.copy()
        px[45:54] = rot_cw(I[45:54])       # Red (R) rotates CW
        px[36:45] = rot_ccw(I[36:45])      # Orange (L) rotates CCW

        px[0:9]   = I[18:27]               # Green (F) -> White (U)
        px[27:36] = rot_180(I[0:9])         # White (U) -> Blue (B) upside down
        px[9:18]  = rot_180(I[27:36])       # Blue (B) -> Yellow (D) upside down
        px[18:27] = I[9:18]                # Yellow (D) -> Green (F)

        self.permutations["x"] = px
        self.permutations["x'"] = np.argsort(px)

        # --- y ROTATION (Entire Cube Yaw - Direction of U) ---
        # Face movements: F -> L, L -> B, B -> R, R -> F
        # U face turns CW, D face turns CCW
        py = I.copy()
        py[0:9]   = rot_cw(I[0:9])         # White (U) rotates CW
        py[9:18]  = rot_ccw(I[9:18])       # Yellow (D) rotates CCW

        py[36:45] = I[18:27]               # Green (F) -> Orange (L)
        py[27:36] = I[36:45]               # Orange (L) -> Blue (B)
        py[45:54] = I[27:36]               # Blue (B) -> Red (R)
        py[18:27] = I[45:54]               # Red (R) -> Green (F)

        self.permutations["y"] = py
        self.permutations["y'"] = np.argsort(py)

    def get_3x3_face_dict(self):
        # np.fliplr performs the hard Y-axis horizontal flip on the 3x3 matrices
        return {
            "White":  self.state[0:9].reshape((3, 3)).tolist(),
            "Yellow": self.state[9:18].reshape((3, 3)).tolist(),
            "Green":  self.state[18:27].reshape((3, 3)).tolist(),
            "Blue":   self.state[27:36].reshape((3, 3)).tolist(),
            "Orange": np.fliplr(self.state[36:45].reshape((3, 3))).tolist(), # Y-axis flip
            "Red":    np.fliplr(self.state[45:54].reshape((3, 3))).tolist(), # Y-axis flip
        }

    def broadcast_state(self):
        """Converts internal 54-element array to a state string and emits via SocketIO."""
        # Convert array state back to string if needed
        state_str = "".join([str(x) for x in self.state])

        # Ensure socketio emits across thread boundaries
        try:
            socketio.emit(
                "cube_state_update",
                {"state": state_str, "last_move": self.last_move_detected},
            )
        except Exception as e:
            print(f"❌ [SocketIO Error]: {e}")

    def calculate_distance(self, scanned_flat_grid, candidate_state):
        mismatches = 0
        for i, idx in enumerate(self.F_INDICES):
            scanned_col = scanned_flat_grid[i]
            if scanned_col == "Unknown":
                continue
            if scanned_col != candidate_state[idx]:
                mismatches += 1
        return mismatches

    def process_frame(self, scanned_grid_2d):
        scanned_flat = [color for row in scanned_grid_2d for color in row]

        if self.last_grid is not None and scanned_flat == self.last_grid:
            self.grid_stable_count += 1
        else:
            self.grid_stable_count = 0
            self.last_grid = scanned_flat
            return None

        if self.grid_stable_count < 2:
            return None

        current_dist = self.calculate_distance(scanned_flat, self.state)
        if current_dist <= self.max_allowed_error:
            return None

        best_move = None
        best_distance = 999
        best_new_state = None
        self.last_candidate_dists = {}

        for move_name, perm in self.permutations.items():
            candidate_state = self.state[perm]
            dist = self.calculate_distance(scanned_flat, candidate_state)
            self.last_candidate_dists[move_name] = dist

            if dist < best_distance:
                best_distance = dist
                best_move = move_name
                best_new_state = candidate_state

        if best_distance <= self.max_allowed_error and best_move is not None:
            self.state = best_new_state
            self.last_move_detected = f"Move: {best_move} (Err: {best_distance})"
            self.move_history.append(best_move)
            self.broadcast_state()
            self.grid_stable_count = 0
            return best_move

        return None

    def state_to_kociemba_string(self, state_array=None):
        """Converts ANY 54-color state array into Kociemba standard string format.

        Flattens state_array to prevent shape/index out of bounds errors.
        """
        if state_array is None:
            state_array = self.state

        # Flatten state array to ensure exact 1D shape (54,)
        flat_state = np.array(state_array).flatten()

        if len(flat_state) != 54:
            print(
                f"⚠️ [Kociemba Error]: Expected state size 54, but got shape {np.shape(state_array)}."
            )
            return None

        try:
            # Map center face colors (indices: 4=U, 13=D, 22=F, 31=B, 40=L, 49=R)
            center_color_map = {
                flat_state[4]: "U",  # White
                flat_state[13]: "D",  # Yellow
                flat_state[22]: "F",  # Green
                flat_state[31]: "B",  # Blue
                flat_state[40]: "L",  # Orange
                flat_state[49]: "R",  # Red
            }

            if len(set(center_color_map.keys())) < 6:
                return None

            u_face = flat_state[0:9]
            r_face = flat_state[45:54]
            f_face = flat_state[18:27]
            d_face = flat_state[9:18]
            l_face = flat_state[36:45]
            b_face = flat_state[27:36]

            kociemba_order = np.concatenate(
                [u_face, r_face, f_face, d_face, l_face, b_face]
            )

            return "".join([center_color_map[color] for color in kociemba_order])

        except (KeyError, IndexError) as e:
            print(f"❌ [Kociemba String Error]: {e}")
            return None

