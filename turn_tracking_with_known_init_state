            cubies.forEach(cubie => {
                const { mesh, x, y, z } = cubie;
                const mats = mesh.material;
                if (x === 1) mats[0].color.setHex(COLOR_MAP[faces.Red[1 - y][z + 1]] || 0x222222);
                if (x === -1) mats[1].color.setHex(COLOR_MAP[faces.Orange[1 - y][1 - z]] || 0x222222);
                if (y === 1) mats[2].color.setHex(COLOR_MAP[faces.White[1 - z][x + 1]] || 0x222222);
                if (y === -1) mats[3].color.setHex(COLOR_MAP[faces.Yellow[z + 1][x + 1]] || 0x222222);
                if (z === 1) mats[4].color.setHex(COLOR_MAP[faces.Green[1 - y][x + 1]] || 0x222222);
                if (z === -1) mats[5].color.setHex(COLOR_MAP[faces.Blue[1 - y][2 - (x + 1)]] || 0x222222);
            });
        }

        createCube();

        socket.on('cube_update', (data) => {
            document.getElementById('active').innerText = data.active_center || 'None';
            document.getElementById('status').innerText = data.status || 'Active';
            if (data.faces) update3DCube(data.faces);
        });

        function animate() {
            requestAnimationFrame(animate);
            controls.update();
            renderer.render(scene, camera);
        }
        animate();
    </script>
</body>
</html>
"""


@app.route("/")
def index():
    return render_template_string(HTML_TEMPLATE)


@socketio.on("connect")
def handle_connect():
    cube_tracker.broadcast_state()


def run_server():
    socketio.run(app, host="0.0.0.0", port=5001, debug=False, use_reloader=False)


# Global cube instance
cube_tracker = RubiksCubeTracker()


def main():
    # Start web server in background thread
    server_thread = threading.Thread(target=run_server, daemon=True)
    server_thread.start()
    print("\n[3D VIEWER READY] Open http://localhost:5001 in your browser.\n")

    last_process_time = 0.0
    process_interval = 0.20

    while True:
        ret, frame = cap.read()
        if not ret:
            break

        frame = cv2.flip(frame, 1)
        h_frame, w_frame, _ = frame.shape
        display_frame = frame.copy()

        results = model(frame, conf=0.40, verbose=False)[0]
        quad_corners = None

        if results.masks is not None and len(results.masks) > 0:
            masks = results.masks.data.cpu().numpy()
            boxes = results.boxes.xyxy.cpu().numpy().astype(int)
            best_idx = np.argmax([(b[2] - b[0]) * (b[3] - b[1]) for b in boxes])

            mask_resized = cv2.resize(masks[best_idx], (w_frame, h_frame))
            mask_binary = (mask_resized > 0.5).astype(np.uint8) * 255

            contours, _ = cv2.findContours(
                mask_binary, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
            )
            if contours:
                cnt = max(contours, key=cv2.contourArea)
                peri = cv2.arcLength(cnt, True)
                approx = cv2.approxPolyDP(cnt, 0.03 * peri, True)
                pts = (
                    approx.reshape(4, 2)
                    if len(approx) == 4
                    else cv2.boxPoints(cv2.minAreaRect(cnt))
                )

                s = pts.sum(axis=1)
                diff = np.diff(pts, axis=1)
                rect = np.zeros((4, 2), dtype="float32")
                rect[0] = pts[np.argmin(s)]
                rect[2] = pts[np.argmax(s)]
                rect[1] = pts[np.argmin(diff)]
                rect[3] = pts[np.argmax(diff)]
                quad_corners = rect

                cv2.polylines(
                    display_frame,
                    [quad_corners.astype(np.int32)],
                    True,
                    (0, 255, 0),
                    2,
                )

        now = time.time()
        if quad_corners is not None and (now - last_process_time) > process_interval:
            last_process_time = now
            current_grid = extract_facelet_grid(frame, quad_corners)
            cube_tracker.process_green_face_scan(current_grid)

        # On-Screen HUD Overlay
        cv2.putText(
            display_frame,
            f"Focused Face: {cube_tracker.active_camera_face}",
            (20, 35),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.7,
            (0, 255, 0),
            2,
        )
        cv2.putText(
            display_frame,
            f"{cube_tracker.last_move_detected}",
            (20, 70),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.7,
            (0, 0, 0),
            2,
        )
        cv2.putText(
            display_frame,
            f"History: {' '.join(cube_tracker.move_history[-10:])}",
            (20, 105),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.5,
            (255, 0, 0),
            1,
        )
        cv2.putText(
            display_frame,
            "Press 'r' to Reset | Press 'q' to Quit",
            (20, h_frame - 20),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.5,
            (0, 0, 0),
            1,
        )

        cv2.imshow("Rubik's Move Logger", display_frame)

        key = cv2.waitKey(1) & 0xFF
        if key == ord("q"):
            break
        elif key == ord("r"):
            cube_tracker.reset_to_solved()

    cap.release()
    cv2.destroyAllWindows()


if __name__ == "__main__":
    main()